    const g3Measure = (w, offIdx) => cw.evaluate(([w, offIdx]) => {
        document.querySelector('.side').style.width = `${w}px`;
        const form = document.querySelector('.castform'), fr = form.getBoundingClientRect();
        const out = { overflow: form.scrollWidth > form.clientWidth + 1, narrow: [], actMin: 1e9, flagsOut: [], rows: 0 };
        for (const row of form.querySelectorAll('.cf-sched')) {
            out.rows++;
            for (const el of row.querySelectorAll('input:not([type=checkbox]):not(.cf-pct), select, .wspick-value, button.crumb')) {
                if (!el.offsetParent) continue;
                const r = el.getBoundingClientRect();
                if (r.width < 60) out.narrow.push(`${el.className || el.tagName}:${Math.round(r.width)}`);
                if (r.right > fr.right + 1) out.flagsOut.push(`${el.className || el.tagName} past the panel`);
            }
            for (const el of row.querySelectorAll('.cf-flags label')) if (el.getBoundingClientRect().right > fr.right + 1) out.flagsOut.push('flags past the panel');
            const act = row.querySelector('.cf-activity'); if (act) out.actMin = Math.min(out.actMin, act.getBoundingClientRect().width);
        }
        return out;
    }, [w, offIdx]);

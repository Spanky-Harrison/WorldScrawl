    const ratPend = await page.evaluate(() => SillyTavern.getContext().chat.flatMap(m => m.extra?.worldscrawl_npc ?? []).filter(s => s.text === 'hates rats').map(s => ({ pending: !!s.pending, off: !!s.off })));

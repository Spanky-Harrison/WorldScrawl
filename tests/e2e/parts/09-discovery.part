        await c.executeSlashCommandsWithOptions('/ws-reveal off'); await new Promise(r => setTimeout(r, 500));
        const known2 = await m.knownText();
        return { pipe: t.pipe, added: c.chat.length - n0, what: sw?.what, off: !('worldscrawl_reveal_map' in (c.chatMetadata ?? {})), same: known2 === known0, b0: known0.split('. Seen')[0].split(',').length, b1: known1.split('. Seen')[0].split(',').length };
    });
    check('/ws-reveal all: a switch, nothing stamped; every place counts as been-there; off is exactly as before', rvl.added === 0 && rvl.what === 'all' && rvl.b1 > 10 && rvl.b1 > rvl.b0 && rvl.off && rvl.same && /Reveal map is on/.test(rvl.pipe ?? ''), JSON.stringify(rvl));
